#!/bin/bash
# Rive Luau static analysis — type checking, linting, and diagnostics
#
# Usage:
#   rive-luau-analyze [luau-lsp analyze options...] <file-or-directory>...
#
# Examples:
#   rive-luau-analyze myScript.luau
#   rive-luau-analyze effects/
#   rive-luau-analyze --luaurc /path/to/.luaurc effects/Glassifier/Glassifier.luau
#
# Exit code 0 = no diagnostics; non-zero = diagnostics or analyzer failure

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
LUAU_LSP="${RIVE_LUAU_LSP_BIN:-${SCRIPT_DIR}/luau-lsp}"

if [ ! -x "${LUAU_LSP}" ] && [ -x "${SCRIPT_DIR}/luau-lsp.exe" ]; then
    LUAU_LSP="${SCRIPT_DIR}/luau-lsp.exe"
fi

# Release archives flatten the binary, wrapper, and definitions into one
# directory. Repository checkouts keep definitions under extension/.
if [ -n "${RIVE_LUAU_DEFS_FILE:-}" ]; then
    RIVE_DEFS="${RIVE_LUAU_DEFS_FILE}"
elif [ -f "${SCRIPT_DIR}/rive-globals.d.luau" ]; then
    RIVE_DEFS="${SCRIPT_DIR}/rive-globals.d.luau"
else
    RIVE_DEFS="${REPO_DIR}/extension/definitions/rive-globals.d.luau"
fi

if [ ! -x "${LUAU_LSP}" ] && [ -x "${REPO_DIR}/build/luau-lsp" ]; then
    LUAU_LSP="${REPO_DIR}/build/luau-lsp"
fi

if [ ! -x "${LUAU_LSP}" ]; then
    echo "Error: luau-lsp binary not found at ${LUAU_LSP}"
    echo "Build with: cmake --build build --target Luau.LanguageServer.CLI -j\$(sysctl -n hw.ncpu)"
    exit 1
fi

if [ $# -eq 0 ]; then
    echo "Usage: rive-luau-analyze [luau-lsp analyze options...] <file-or-directory>..."
    echo ""
    echo "Runs luau-lsp static analysis with Rive type definitions."
    echo "Uses --force-strict-mode for full parity with Rive editor."
    echo ""
    echo "Examples:"
    echo "  rive-luau-analyze myScript.luau"
    echo "  rive-luau-analyze effects/"
    echo "  rive-luau-analyze --formatter=plain ."
    echo ""
    echo "Analyzer options must appear before the first file or directory."
    exit 1
fi

ANALYZE_OUTPUT="$(mktemp "${TMPDIR:-/tmp}/rive-luau-analyze.XXXXXX")"
if [ -z "${ANALYZE_OUTPUT}" ]; then
    echo "Error: unable to create analyzer output capture" >&2
    exit 1
fi

ACTIONABLE_OUTPUT="$(mktemp "${TMPDIR:-/tmp}/rive-luau-actionable.XXXXXX")"
if [ -z "${ACTIONABLE_OUTPUT}" ]; then
    echo "Error: unable to create actionable analyzer output capture" >&2
    rm -f -- "${ANALYZE_OUTPUT}"
    exit 1
fi

cleanup() {
    rm -f -- "${ANALYZE_OUTPUT}" "${ACTIONABLE_OUTPUT}"
}
trap cleanup EXIT

"${LUAU_LSP}" analyze \
    "--definitions=@rive=${RIVE_DEFS}" \
    --flag:LuauSolverV2=true \
    --force-strict-mode \
    "$@" >"${ANALYZE_OUTPUT}" 2>&1
ANALYZE_STATUS=$?

# The plain formatter currently exits 0 even when it emits diagnostics. Remove
# the routine definitions-load info line, replay every actionable line, retain
# genuine process failures, and give diagnostics status 1 for shell/CI callers.
sed '/^\[INFO\] Loading definitions file: /d' "${ANALYZE_OUTPUT}" >"${ACTIONABLE_OUTPUT}"
cat "${ACTIONABLE_OUTPUT}"

if [ "${ANALYZE_STATUS}" -ne 0 ]; then
    exit "${ANALYZE_STATUS}"
fi

if [ -s "${ACTIONABLE_OUTPUT}" ]; then
    exit 1
fi

exit 0
