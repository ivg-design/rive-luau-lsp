#!/bin/bash
# Rive Luau Language Server — for editor integration or agent use
#
# Usage:
#   rive-luau-lsp                     # start LSP server (stdio)
#   rive-luau-lsp [extra-flags...]    # pass additional luau-lsp flags
#
# This starts the language server in LSP mode over stdio, with Rive
# type definitions and documentation pre-loaded. Connect to it from
# any LSP client (VS Code, Neovim, Emacs, or a Claude Code agent).

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/../.." && pwd)"
LUAU_LSP="${RIVE_LUAU_LSP_BIN:-${SCRIPT_DIR}/luau-lsp}"

if [ ! -x "${LUAU_LSP}" ] && [ -x "${SCRIPT_DIR}/luau-lsp.exe" ]; then
    LUAU_LSP="${SCRIPT_DIR}/luau-lsp.exe"
fi

# Release archives flatten the binary, wrappers, definitions, and docs into
# one directory. Repository checkouts keep definitions under extension/.
if [ -n "${RIVE_LUAU_DEFS_FILE:-}" ]; then
    RIVE_DEFS="${RIVE_LUAU_DEFS_FILE}"
elif [ -f "${SCRIPT_DIR}/rive-globals.d.luau" ]; then
    RIVE_DEFS="${SCRIPT_DIR}/rive-globals.d.luau"
else
    RIVE_DEFS="${REPO_DIR}/extension/definitions/rive-globals.d.luau"
fi

if [ -n "${RIVE_LUAU_DOCS_FILE:-}" ]; then
    RIVE_DOCS="${RIVE_LUAU_DOCS_FILE}"
elif [ -f "${SCRIPT_DIR}/luau-api-docs.json" ]; then
    RIVE_DOCS="${SCRIPT_DIR}/luau-api-docs.json"
else
    RIVE_DOCS="${REPO_DIR}/extension/definitions/luau-api-docs.json"
fi

if [ ! -x "${LUAU_LSP}" ] && [ -x "${REPO_DIR}/build/luau-lsp" ]; then
    LUAU_LSP="${REPO_DIR}/build/luau-lsp"
fi

if [ ! -x "${LUAU_LSP}" ]; then
    echo "Error: luau-lsp binary not found at ${LUAU_LSP}" >&2
    echo "Build with: cmake --build build --target Luau.LanguageServer.CLI -j\$(sysctl -n hw.ncpu)" >&2
    exit 1
fi

exec "${LUAU_LSP}" lsp \
    "--definitions=@rive=${RIVE_DEFS}" \
    "--docs=${RIVE_DOCS}" \
    --flag:LuauSolverV2=true \
    --force-strict-mode \
    "$@"
